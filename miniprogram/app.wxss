page {
  background: #f5f7f8;
  color: #172026;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  padding: 28rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #d9e0e6;
  border-radius: 12rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtle {
  color: #5d6872;
  font-size: 24rpx;
  line-height: 1.55;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.between {
  justify-content: space-between;
}

.input {
  width: 100%;
  min-height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #c9d3db;
  border-radius: 10rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.label {
  display: block;
  margin: 22rpx 0 10rpx;
  color: #5d6872;
  font-size: 24rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.primary-btn,
.secondary-btn {
  border-radius: 10rpx;
  font-weight: 700;
}

.primary-btn {
  background: #2563a9;
  color: #ffffff;
}

.secondary-btn {
  background: #ffffff;
  color: #2563a9;
  border: 1rpx solid #b8c9dc;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.rush { background: #fff1d7; color: #a45f08; }
.steady { background: #e4f4ee; color: #18755a; }
.safe { background: #e7f0f8; color: #2563a9; }
.info { background: #eef1f3; color: #52606b; }

.card {
  background: #ffffff;
  border: 1rpx solid #d9e0e6;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.meta {
  color: #5d6872;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 10rpx;
}

.risk {
  color: #172026;
  font-size: 24rpx;
  line-height: 1.55;
  margin-top: 14rpx;
}
