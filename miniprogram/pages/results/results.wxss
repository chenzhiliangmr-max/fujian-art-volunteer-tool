.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.small-btn {
  width: 132rpx;
  margin: 0;
  font-size: 24rpx;
}

.head-actions {
  display: grid;
  gap: 12rpx;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-btn {
  font-size: 24rpx;
  margin: 0;
}
