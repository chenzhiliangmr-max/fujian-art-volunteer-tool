.seg {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border: 1rpx solid #c9d3db;
  border-radius: 10rpx;
  overflow: hidden;
}

.seg button {
  background: #ffffff;
  color: #172026;
  border: 0;
  border-radius: 0;
}

.seg button.active {
  background: #e7f0f8;
  color: #2563a9;
  font-weight: 700;
}

.formula {
  margin-top: 22rpx;
  padding: 18rpx;
  background: #eef7f8;
  color: #0f6d7a;
  border-radius: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.option-row {
  min-height: 82rpx;
  border-bottom: 1rpx solid #edf1f4;
}

.option-row:last-of-type {
  border-bottom: 0;
}

.summary-panel {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.big {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.big.small {
  font-size: 34rpx;
}

.generate {
  margin-top: 8rpx;
}

.rank-inputs {
  margin-top: 8rpx;
}

.textarea {
  width: 100%;
  min-height: 170rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #c9d3db;
  border-radius: 10rpx;
  box-sizing: border-box;
  font-size: 24rpx;
}

.clear-rank {
  margin-top: 18rpx;
  font-size: 24rpx;
}
